{
  "expo": {
    "name": "Purple Haze Restro & Garden",
    "slug": "purplehaze-mobile",
    "scheme": "purplehaze",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bistacreation.purplehaze"
    },
    "android": {
      "package": "com.bistacreation.purplehaze",
      "adaptiveIcon": {
        "backgroundColor": "#54266D",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#54266D"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://purplehaze-nine.vercel.app/api/v1",
      "websiteUrl": "https://purplehaze-nine.vercel.app",
      "eas": {
        "projectId": "96309d2f-a6d1-4e19-a11f-65aa8c7b979d"
      }
    },
    "owner": "bistacreation"
  }
}

{
  "expo": {
    "name": "Purple Haze Restro & Garden",
    "slug": "purplehaze-mobile",
    "scheme": "purplehaze",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bistacreation.purplehaze",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.bistacreation.purplehaze",
      "versionCode": 11,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FAF7F2",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#54266D"
        }
      ],
      "expo-font",
      "@react-native-google-signin/google-signin",
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.4.0"
          }
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://purplehaze-nine.vercel.app/api/v1",
      "websiteUrl": "https://purplehaze-nine.vercel.app",
      "firebaseProjectId": "purple-haze-cfeb7",
      "eas": {
        "projectId": "96309d2f-a6d1-4e19-a11f-65aa8c7b979d"
      }
    },
    "owner": "bistacreations-team"
  }
}

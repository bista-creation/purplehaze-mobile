{
  "expo": {
    "name": "Purple Haze Restro & Garden",
    "slug": "purplehaze-mobile",
    "scheme": "purplehaze",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0b0716"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bistacreation.purplehaze"
    },
    "android": {
      "package": "com.bistacreation.purplehaze",
      "adaptiveIcon": {
        "backgroundColor": "#0b0716",
        "foregroundImage": "./assets/android-icon-foreground.png"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7c3aed"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://purplehaze-nine.vercel.app/api/v1",
      "websiteUrl": "https://purplehaze-nine.vercel.app"
    }
  }
}
